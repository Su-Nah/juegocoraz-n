[node name="Lista" type="Label" parent="Ayuda/V"]
layout_mode = 2
theme_override_colors/font_color = Color(0.15, 0.12, 0.14, 1)
theme_override_font_sizes/font_size = 22
text = "• Mira el bocadillo del gato: es el dango que pide (de abajo arriba).
   VERDE ▲ · BLANCA ■ · ROSA ● · SALSA ≈
• ARRASTRA una bola del cuenco a la bandeja (o TOCA el cuenco).
• TOCA la olla para añadir salsa.
• ARRASTRA la bandeja hasta el gato (o TOCA la bandeja) para entregar.
• ¿Salió mal? Al BOTE (arrastrar o tocar) y empieza otro.
• Un cuenco en el suelo: TÓCALO para recogerlo.
• CAMPANILLA (arriba a la izquierda): para y respira. El juego sigue.
• TABLILLA o tecla ESC: pausa del juego."
autowrap_mode = 3

[node name="Cerrar" type="Button" parent="Ayuda/V"]
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 22
text = "Entendido"
